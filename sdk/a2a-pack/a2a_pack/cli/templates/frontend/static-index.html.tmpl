<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ name }} app</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #090909;
        color: #f4f4f4;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
      }
      main {
        width: min(760px, calc(100vw - 40px));
        border: 1px solid #242424;
        border-radius: 8px;
        padding: 28px;
        background: #0f0f0f;
      }
      h1 {
        margin: 0 0 12px;
        font-size: clamp(28px, 5vw, 52px);
        line-height: 1;
        letter-spacing: 0;
      }
      p {
        color: #b8b8b8;
        line-height: 1.6;
      }
      button {
        border: 1px solid #e7e7e7;
        border-radius: 6px;
        background: #f6f6f6;
        color: #101010;
        padding: 10px 14px;
        font: inherit;
        cursor: pointer;
      }
      pre {
        overflow: auto;
        border: 1px solid #242424;
        border-radius: 6px;
        padding: 14px;
        background: #070707;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{{ name }}</h1>
      <p>This packed frontend is served by the same deployed A2A agent.</p>
      <button id="load">Load agent contract</button>
      <pre id="out">Waiting...</pre>
    </main>
    <script type="module">
      import { createA2AClient } from "./a2a-client.js";

      const out = document.querySelector("#out");
      document.querySelector("#load").addEventListener("click", async () => {
        const agent = await createA2AClient();
        out.textContent = JSON.stringify(agent.config, null, 2);
      });
    </script>
  </body>
</html>
