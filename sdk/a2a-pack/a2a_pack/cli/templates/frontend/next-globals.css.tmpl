:root {
  color-scheme: light;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f6f7f8;
  color: #191b1f;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background: #f6f7f8;
}

button,
input {
  font: inherit;
}

.shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(280px, 360px) 1fr;
}

.sidebar {
  padding: 32px;
  background: #101418;
  color: #f7f9fb;
  display: grid;
  align-content: start;
  gap: 24px;
}

.eyebrow {
  margin: 0;
  color: #62c5a8;
  font-size: 12px;
  letter-spacing: 0;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 0;
  font-size: 48px;
  line-height: 1;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

h2 {
  margin: 4px 0 0;
  font-size: 24px;
  letter-spacing: 0;
}

h3 {
  margin-bottom: 12px;
  font-size: 14px;
  letter-spacing: 0;
}

.description {
  color: #c9d0d6;
  line-height: 1.55;
}

.meta {
  border: 1px solid #303941;
  border-radius: 8px;
  padding: 16px;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 8px 14px;
}

.meta span {
  color: #9faab3;
}

.meta strong {
  overflow-wrap: anywhere;
}

.workspace {
  padding: 32px;
  display: grid;
  align-content: start;
  gap: 22px;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.status {
  border: 1px solid #cbd1d6;
  border-radius: 999px;
  padding: 7px 10px;
  color: #3f4a52;
  font-size: 13px;
}

.runner {
  display: grid;
  grid-template-columns: repeat(2, minmax(120px, 1fr)) auto;
  gap: 12px;
  align-items: end;
}

label {
  display: grid;
  gap: 8px;
  color: #46515a;
}

input {
  min-height: 44px;
  border: 1px solid #cbd1d6;
  border-radius: 8px;
  background: #fff;
  padding: 10px 12px;
  color: #171a1d;
}

button {
  min-height: 44px;
  border: 1px solid #111;
  border-radius: 8px;
  background: #15191d;
  color: #fff;
  padding: 10px 16px;
  cursor: pointer;
}

button:disabled {
  cursor: default;
  opacity: 0.55;
}

.output {
  border: 1px solid #d7dce0;
  border-radius: 8px;
  background: #fff;
  padding: 16px;
}

pre {
  margin: 0;
  overflow: auto;
  white-space: pre-wrap;
  color: #21262b;
}

@media (max-width: 760px) {
  .shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    min-height: auto;
  }

  .runner {
    grid-template-columns: 1fr;
  }
}
