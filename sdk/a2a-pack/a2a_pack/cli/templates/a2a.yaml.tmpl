# Project identity for `a2a deploy`. Most metadata (resources, scopes,
# secrets, workspace, etc.) lives on the Python class — this file only
# tells the CLI how to find it.
name: {{ name }}
version: 0.1.0
entrypoint: agent:{{ class_name }}
expose:
  # Registry listing only. `false` keeps the agent out of the public
  # registry at a2acloud.io; it is not access control — the agent still
  # gets its canonical https URL, and who may call it is decided by the
  # auth model declared on the agent. Set this to true (or run
  # `a2a deploy --public` once) to list it.
  public: false
# Optional platform resources:
# resources:
#   memory:
#     tiers: [kv, vector]
#     namespace: {{ name }}
#   databases:
#     - name: app
#       provider: neon
#       engine: postgres
#       env:
#         url: DATABASE_URL
{{ frontend_block }}
